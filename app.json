{
  "expo": {
    "name": "Student Manager",
    "slug": "BangSV",
    "version": "1.0.0",
    "orientation": "portrait",
    "plugins": [
      [
        "expo-localization",
        { "supportedLocales": { "ios": ["en", "vi"], "android": ["en", "vi"] } }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "Cho phép truy cập ảnh để chọn avatar / Allow photo access to pick an avatar" }
      ]
    ],
    "locales": {
      "vi": "./locales/vi.json",
      "en": "./locales/en.json"
    }
  }
}